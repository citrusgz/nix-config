#!/usr/bin/env bash
set -euo pipefail

repo="${NIX_CONFIG_DIR:-$HOME/nix-config}"
dest="$repo/modules/plasma-generated.nix"
tmp="$(mktemp)"

nix run github:nix-community/plasma-manager >"$tmp"

sed -e '/^    enable = true;$/d' -e '/^    dataFile = {/,/^    };$/d' "$tmp" >"$dest"

rm -f "$tmp"

echo "Atualizado: $dest"
echo "Revise com 'git diff' e rode: sudo nixos-rebuild switch --flake $repo#nixos"
